{
  "appId": "com.drselftape.app",
  "appName": "Dr Self Tape",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FAFAF7",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#FAFAF7",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FAFAF7"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
