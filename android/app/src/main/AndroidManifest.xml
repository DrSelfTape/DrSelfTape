<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Self-tape recording + live rehearsals use the WebView's getUserMedia
         (SelfTapeRecorder). Android needs these declared for the Capacitor
         WebChromeClient to grant camera/mic at runtime; iOS declares the
         equivalent NSCamera/NSMicrophone usage strings. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android FCM push (parity with the iOS APNs path). POST_NOTIFICATIONS is
         required on Android 13+ to display notifications; the C2DM RECEIVE
         permission is injected by @capacitor/push-notifications / Firebase
         Messaging and no longer stripped. Requires google-services.json in
         android/app/ at build time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app does not use the advertising ID (no ad/attribution SDKs).
         Explicitly remove the AD_ID permission a dependency might inject so the
         Play "Advertising ID" declaration ("No") is provably correct. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
